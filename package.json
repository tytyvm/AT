{
  "name": "agentic-wallet-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "worker": "tsx src/workers/indexer.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bullmq": "5.34.0",
    "ioredis": "5.4.1",
    "next": "15.1.6",
    "prisma": "5.22.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tsx": "4.19.2",
    "viem": "2.22.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
