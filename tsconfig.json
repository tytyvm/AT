{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "ES2022"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true, "jsx": "preserve",
    "noEmit": true, "incremental": true, "isolatedModules": true,
    "baseUrl": ".", "paths": { "@/*": ["src/*"] },
    "plugins": [{ "name": "next" }]
  },
  "include": ["src", "tests", "prisma", "next-env.d.ts"],
  "exclude": ["node_modules"]
}
